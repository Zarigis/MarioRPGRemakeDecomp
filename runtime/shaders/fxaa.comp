#version 450
// FXAA on the game's scene colour (runtime/vk_fxaa.c): src is a copy of the B10G11R11 scene, dst the scene itself.
// The algorithm is Timothy Lottes' FXAA 3.11 "quality" variant as published by NVIDIA (FXAA_QUALITY__PRESET 12:
// edge search of up to 5 steps either way), written here from its description: luma from the local 3x3, an early exit
// where the contrast is low, the edge direction from the 3x3 gradients, a search along the edge for its ends, and a
// blend toward the neighbour across the edge by how far the pixel sits from the nearer end, plus a sub-pixel blend.
// The scene is linear light and may exceed 1: luma is taken from the colour clamped to 1 and put through a square
// root (close to the display's gamma), so edges are judged as they will look.
// pc.x, pc.y: 1 / size; pc.z: sub-pixel amount (0..1); pc.w: edge threshold.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
layout(push_constant) uniform P { vec4 pc; ivec4 size; } p;

float luma(vec3 c) { return sqrt(dot(min(c, vec3(1.0)), vec3(0.299, 0.587, 0.114))); }
vec3 at(vec2 uv) { return textureLod(src, uv, 0.0).rgb; }
float lum(vec2 uv) { return luma(at(uv)); }

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(ip, p.size.xy))) return;
    vec2 rcp = p.pc.xy, uv = (vec2(ip) + 0.5) * rcp;
    vec3 cM = at(uv);
    float lM = luma(cM);
    float lN = lum(uv + vec2(0, -rcp.y)), lS = lum(uv + vec2(0, rcp.y));
    float lW = lum(uv + vec2(-rcp.x, 0)), lE = lum(uv + vec2(rcp.x, 0));
    float lo = min(lM, min(min(lN, lS), min(lW, lE))), hi = max(lM, max(max(lN, lS), max(lW, lE)));
    float range = hi - lo;
    if (range < max(0.0312, hi * p.pc.w)) {   // flat enough: unchanged
        imageStore(dst, ip, vec4(cM, 1.0));
        return;
    }
    float lNW = lum(uv + vec2(-rcp.x, -rcp.y)), lNE = lum(uv + vec2(rcp.x, -rcp.y));
    float lSW = lum(uv + vec2(-rcp.x, rcp.y)), lSE = lum(uv + vec2(rcp.x, rcp.y));
    // sub-pixel aliasing: how much the centre differs from its neighbourhood's average
    float avg = (2.0 * (lN + lS + lW + lE) + lNW + lNE + lSW + lSE) / 12.0;
    float sub = clamp(abs(avg - lM) / range, 0.0, 1.0);
    sub = smoothstep(0.0, 1.0, sub);
    sub = sub * sub * p.pc.z;
    // edge orientation
    float edgeH = abs(lNW + lNE - 2.0 * lN) + 2.0 * abs(lW + lE - 2.0 * lM) + abs(lSW + lSE - 2.0 * lS);
    float edgeV = abs(lNW + lSW - 2.0 * lW) + 2.0 * abs(lN + lS - 2.0 * lM) + abs(lNE + lSE - 2.0 * lE);
    bool horz = edgeH >= edgeV;
    float l1 = horz ? lN : lW, l2 = horz ? lS : lE;   // the two neighbours across the edge
    float g1 = abs(l1 - lM), g2 = abs(l2 - lM);
    bool first = g1 >= g2;
    float grad = 0.25 * max(g1, g2);
    float stepLen = horz ? rcp.y : rcp.x;
    float lLocal = 0.5 * ((first ? l1 : l2) + lM);
    if (first) stepLen = -stepLen;
    vec2 cur = uv;
    if (horz) cur.y += stepLen * 0.5; else cur.x += stepLen * 0.5;
    // search along the edge both ways for where its luma leaves the local value
    vec2 off = horz ? vec2(rcp.x, 0.0) : vec2(0.0, rcp.y);
    const float steps[5] = float[](1.0, 1.5, 2.0, 4.0, 8.0);
    vec2 u1 = cur - off, u2 = cur + off;
    float e1 = lum(u1) - lLocal, e2 = lum(u2) - lLocal;
    bool d1 = abs(e1) >= grad, d2 = abs(e2) >= grad;
    for (int i = 1; i < 5 && !(d1 && d2); i++) {
        if (!d1) { u1 -= off * steps[i]; e1 = lum(u1) - lLocal; d1 = abs(e1) >= grad; }
        if (!d2) { u2 += off * steps[i]; e2 = lum(u2) - lLocal; d2 = abs(e2) >= grad; }
    }
    float dist1 = horz ? uv.x - u1.x : uv.y - u1.y, dist2 = horz ? u2.x - uv.x : u2.y - uv.y;
    bool nearer1 = dist1 < dist2;
    float dist = min(dist1, dist2), total = dist1 + dist2;
    bool centreBelow = lM < lLocal;
    bool good = ((nearer1 ? e1 : e2) < 0.0) != centreBelow;   // the end's side matches the centre's
    float edgeOff = good ? 0.5 - dist / total : 0.0;
    float o = max(edgeOff, sub);
    vec2 fin = uv;
    if (horz) fin.y += o * stepLen; else fin.x += o * stepLen;
    imageStore(dst, ip, vec4(at(fin), 1.0));
}
