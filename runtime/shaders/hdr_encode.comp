#version 450
// HDR10 encode on the present (runtime/vk_hdr.c vk_hdr_encode): the game's picture, crop rectangle at offset, linear
// Rec. 709 with the HUD's white at 1.0 (an sRGB view decodes the 8-bit window texture), into an RGBA16F image of PQ
// code values in Rec. 2020 that FSR 1 or the blit then scale into the HDR10 swapchain. p.x: nits of 1.0, p.y: the
// display's peak in nits, p.z: 1 when the source holds sRGB-encoded values in a UNORM format.
// p.w > 0: scene is the float picture the game copied into the window image before it drew its HUD there (Super Mario
// RPG: a plain copy, which the 8-bit image clips at 1.0). Where the window still shows that copy, the scene's own value
// goes out, highlights above 1.0 included; where the HUD changed the pixel, the window's value does. "Still shows the
// copy" is tested on the 8-bit sRGB codes, within one and a half steps. p.w = 2 marks what was taken instead: red
// where the scene is above 1.0, green elsewhere, the window's pixels in grey.
// adj: the colour profile (runtime/vk_color.c vk_color_adjust), as shaders/color_grade.comp applies it to the SDR
// picture: on sRGB-encoded values, brightness added, contrast around mid-grey, saturation against Rec. 709 luma, then
// a power curve. Values above the HUD's white go through the same lines (the sRGB curve and the contrast line carry on
// past 1), so highlights keep their place above it; SDR clips them at 1 instead.
// PQ: SMPTE ST 2084; the Rec. 709 to Rec. 2020 matrix: ITU-R BT.2087.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(binding = 2) uniform sampler2D scene;
layout(push_constant) uniform P {
    ivec2 offset;
    ivec2 size;
    vec4 p;
    vec4 adj;
} pc;

vec3 srgb_decode(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

vec3 srgb_encode(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}

vec3 pq(vec3 nits) {
    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * y) / (1.0 + c3 * y), vec3(m2));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, pc.size))) return;
    vec3 c = max(texelFetch(src, at + pc.offset, 0).rgb, vec3(0.0));
    if (pc.p.z > 0.5) c = srgb_decode(clamp(c, 0.0, 1.0));
    if (pc.p.w > 0.5) {
        // the game keeps its scene upside down and the copy turns it over (seen in a frame dump: the same picture,
        // mirrored top to bottom), so row y of the window is row height - 1 - y of the scene
        ivec2 q = at + pc.offset;
        vec3 s = max(texelFetch(scene, ivec2(q.x, textureSize(scene, 0).y - 1 - q.y), 0).rgb, vec3(0.0));
        vec3 d = abs(srgb_encode(clamp(s, 0.0, 1.0)) - srgb_encode(clamp(c, 0.0, 1.0)));
        bool same = all(lessThan(d, vec3(1.5 / 255.0)));
        if (pc.p.w > 1.5) {
            float g = dot(c, vec3(0.2126, 0.7152, 0.0722));
            c = !same ? vec3(g) : any(greaterThan(s, vec3(1.0))) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.5 * g + 0.1, 0.0);
        } else if (same) {
            c = s;
        }
    }
    if (pc.p.w < 1.5 && pc.adj != vec4(0.0, 1.0, 1.0, 1.0)) {
        vec3 e = srgb_encode(c) + pc.adj.x;
        e = (e - 0.5) * pc.adj.y + 0.5;
        e = mix(vec3(dot(e, vec3(0.2126, 0.7152, 0.0722))), e, pc.adj.z);
        c = srgb_decode(pow(max(e, vec3(0.0)), vec3(pc.adj.w)));
    }
    const mat3 to2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
    vec3 nits = min(max(to2020 * c, vec3(0.0)) * pc.p.x, vec3(pc.p.y));
    imageStore(dst, at, vec4(pq(nits), 1.0));
}
